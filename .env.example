# Copy to .env and adjust as needed. docker compose reads .env automatically.

# Frontend
# Server-side calls from Next.js. In Docker Compose, this should be
# http://api-gateway:8080/api; local pnpm dev can use localhost.
COURTSYNC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# PostgreSQL (one container; per-service schemas created by infra/postgres/init.sql)
POSTGRES_USER=courtsync
POSTGRES_PASSWORD=courtsync
POSTGRES_DB=courtsync

# Production Supabase pattern:
# - Use the same Supabase project database for all DB-backed services.
# - Give each service its own schema through the JDBC currentSchema parameter.
# - Set POSTGRES_USER=postgres and POSTGRES_PASSWORD to the Supabase DB password
#   in your deployment secret manager, not in this file.
#
# Example per-service URL shape:
# jdbc:postgresql://db.aeojyhopmxgtzedqughe.supabase.co:5432/postgres?sslmode=require&currentSchema=courts

# Service URLs (compose network hostnames)
USER_SERVICE_URL=http://user-service:8081
COURT_SERVICE_URL=http://court-service:8082
DROPIN_SERVICE_URL=http://dropin-service:8083
MESSAGING_SERVICE_URL=http://messaging-service:8084
PAYMENT_SERVICE_URL=http://payment-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8086
SEARCH_SERVICE_URL=http://search-service:8087

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Future: Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Future: Email (Resend)
RESEND_API_KEY=

# Future: Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
