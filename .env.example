# Copy to .env and adjust as needed. docker compose reads .env automatically.

# Frontend
# Server-side calls from Next.js. In Docker Compose, this should be
# http://api-gateway:8080/api; local pnpm dev can use localhost.
COURTSYNC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_SUPABASE_URL=https://aeojyhopmxgtzedqughe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hosted Supabase Postgres
# The password is the database password from Supabase Dashboard -> Connect.
# Do not commit the real password. Put it in your local .env or deployment secret manager.
SUPABASE_PROJECT_REF=aeojyhopmxgtzedqughe
SUPABASE_AUTH_ISSUER=https://aeojyhopmxgtzedqughe.supabase.co/auth/v1
SUPABASE_JDBC_BASE_URL=jdbc:postgresql://db.aeojyhopmxgtzedqughe.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# If your network cannot reach the direct IPv6 endpoint, use the Supabase Session
# Pooler URL instead and set the pooler username, usually postgres.<project-ref>.
# SUPABASE_JDBC_BASE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_USER=postgres.aeojyhopmxgtzedqughe

# Service URLs (compose network hostnames)
USER_SERVICE_URL=http://user-service:8081
COURT_SERVICE_URL=http://court-service:8082
DROPIN_SERVICE_URL=http://dropin-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8086

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Future: Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Future: Email (Resend)
RESEND_API_KEY=

# Future: Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
