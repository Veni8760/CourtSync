root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,md,css,scss,html}]
indent_size = 2

[*.java]
indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.{xml,gradle}]
indent_size = 4

[Makefile]
indent_style = tab
